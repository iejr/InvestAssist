# market-feed configuration. Copy to .env and adjust, or export these directly.

# --- Database ---------------------------------------------------------------
# Postgres DSN (key=value form, space-separated). Same DB as server-go by
# default. The database itself must already exist; tables are auto-created.
DATABASE_URL="host=localhost port=5432 user=postgres password=postgres dbname=invest_assist sslmode=disable"

# Optional: store historical candles in a SEPARATE Postgres instance.
# If unset, price_candles live in DATABASE_URL alongside latest_prices.
# MF_HISTORY_DATABASE_URL="host=history-db port=5432 user=postgres password=postgres dbname=invest_assist_history sslmode=disable"

# --- Ingestion --------------------------------------------------------------
# Comma-separated Binance symbols (Binance notation, e.g. BTCUSDT,ETHUSDT).
MF_SYMBOLS="BTCUSDT"

# OHLC sampling intervals (comma-separated Go durations). One sampler runs per
# interval off the same stream, e.g. "1m,5m" for two candle resolutions.
MF_SAMPLE_INTERVALS="1m"

# latest_prices write coalescing: at most one write per edge per window, keeping
# the newest value. Keeps a bursty stream from hammering Postgres. 0 disables.
MF_LATEST_COALESCE="1s"

# Binance combined-stream websocket base URL (override for testnet).
MF_BINANCE_WS="wss://stream.binance.com:9443"
MF_BINANCE_REST="https://api.binance.com"

# Kraken REST base URL. Backs stablecoin->USD poll/backfill jobs (real USD
# markets for USDT and USDC, never assumed 1:1) and, later, XMR OHLC.
MF_KRAKEN_REST="https://api.kraken.com"

# --- Jobs (L4) --------------------------------------------------------------
# Path to the YAML job list (stream / poll / backfill). If unset, a built-in
# default is used: stream MF_SYMBOLS from Binance + daily Kraken stablecoin
# poll (latest) and 1d backfill (candles) for USDT/USD and USDC/USD.
# MF_JOBS_FILE="jobs.yaml"
