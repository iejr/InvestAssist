# Shared Postgres DSN. Holds the strategy tables (strategies, transactions)
# plus price_candles. Matches market-feed's DATABASE_URL so both services can
# point at the same instance.
DATABASE_URL=host=localhost user=postgres password=postgres dbname=invest_assist port=5432 sslmode=disable

# Redis address backing latest_prices (a single HASH, field "{base}/{quote}").
# Matches market-feed's MF_REDIS_ADDR so both services share the same Redis.
MF_REDIS_ADDR=localhost:6379
# MF_REDIS_DB=0
# MF_REDIS_PASSWORD=

# HTTP listen port.
PORT=3000

# Overrides the default per-strategy staleness window (one interval-step:
# ~1 week for weekly, ~1 month for monthly). Beyond this window a price is
# reported missing rather than used. Go duration syntax (e.g. 48h). Leave
# empty to use the default.
STRATEGY_MAX_STALENESS=
